NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Alertes e-mail (nouvelle demande, devis accepté en ligne) via resend.com. Facultatif.
RESEND_API_KEY=re_YOUR_KEY
ALERT_EMAIL=vous@houdli.ma
# Après vérification du domaine houdli.ma chez Resend, par exemple : Houdli <alertes@houdli.ma>
ALERT_FROM=

# Alertes WhatsApp via callmebot.com, vers votre propre numéro. Facultatif.
WHATSAPP_PHONE=+212600000000
CALLMEBOT_API_KEY=

# Agent vocal Lina, version gratuite : voix du navigateur + Gemini. Clé gratuite sur aistudio.google.com (serveur uniquement).
# Sans cette clé, le bouton de Lina n'apparaît pas.
GEMINI_API_KEY=
# Facultatif : autre modèle Gemini.
GEMINI_MODEL=
# Mettre « elevenlabs » pour utiliser l'agent ElevenLabs à la place.
NEXT_PUBLIC_LINA_ENGINE=

# Agent vocal ElevenLabs (scripts/voice-agent.mjs). La clé reste côté serveur ; l’identifiant de l’agent est public.
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
